{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Chạy ứng dụng quản lý cửa hàng thuốc",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "chcp 65001; $sources = Get-ChildItem -Path src -Recurse -Filter *.java | ForEach-Object { $_.FullName }; javac -encoding UTF-8 -d out $sources; if ($LASTEXITCODE -eq 0) { java -cp out Main }"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
